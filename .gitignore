# Generated outputs
# results/ is deliberately TRACKED (2026-09-23): the matrices cost 8-30 hours
# each to rebuild and were living only in the working tree, unprotected.
# Two files vanished from disk during that period with no explanation.
#
# Ignore only the transient pieces:
results/**/*.tmp
# append-only crash journal; the .json snapshot is the durable record.
# (git has no inline comments -- a "#" after a pattern becomes part of it.)
results/**/*.jsonl
results/**/_tmp_*
results/**/*_dryrun.*
# Configuration-grid dataset (grid_build_matrix.py): far too large for git.
# Back it up by copying the folder.
results/config_grid/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
# Separate environment for pflacco features only (its numpy/scipy/sklearn
# pins are older than the main .venv's, so it is kept apart).
.venv-pflacco/
venv/
env/
.env/

# Secrets: .env holds the Gemini API key. ".env/" above matches only a
# folder, so the file itself needs its own line.
.env

# Distribution / packaging
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/
*.ipynb
